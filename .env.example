# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/off-the-record
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@cliente.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Off The Record <onboarding@resend.dev>

# --- Vercel Cron ---
# Vercel manda Authorization: Bearer $CRON_SECRET en cada corrida.
CRON_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL pública del API (para el webhook de Telegram)
PUBLIC_API_URL=

# --- Vercel AI Gateway (Jev decide, Claude redacta) ---
# En Vercel se usa el token OIDC automáticamente; en local: vercel env pull
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
GATEWAY_WRITING_MODEL=anthropic/claude-sonnet-5
GATEWAY_FAST_MODEL=anthropic/claude-haiku-4.5
JEV_ECUADOR_MIN=0.5
JEV_DUPLICATE_MIN=0.6

# --- IA ---
ANTHROPIC_API_KEY=
# Solo si la llave no está ligada a un workspace
ANTHROPIC_WORKSPACE_ID=
PERPLEXITY_API_KEY=
AI_SCORING_MODEL=claude-haiku-4-5-20251001
AI_WRITING_MODEL=claude-sonnet-5
PERPLEXITY_MODEL=sonar
PERPLEXITY_WRITING_MODEL=sonar-pro
PUBLISH_THRESHOLD=7
AUTO_PUBLISH=false
MAX_DRAFTS_PER_RUN=3
# Hechos con puntaje entre WATCHLIST_MIN y PUBLISH_THRESHOLD esperan más fuentes
WATCHLIST_MIN=5
# N1: publicar solas las actualizaciones sin errores de verificación
AUTO_PUBLISH_UPDATES=false
MAX_UPDATES_PER_RUN=2
NEWSROOM_START_HOUR=8
NEWSROOM_END_HOUR=17

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Grupo de la Mesa (id negativo), donde llegan las notas con botones
TELEGRAM_MESA_CHAT_ID=
# Ids de usuario de Telegram, separados por coma. Editores aprueban, publican y retiran;
# reporteros mandan #nota y queda por aprobar.
TELEGRAM_EDITOR_IDS=
TELEGRAM_REPORTER_IDS=
# (compatibilidad) chat ids de editores
TELEGRAM_EDITOR_CHAT_IDS=
