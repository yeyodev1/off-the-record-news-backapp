{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsroom",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/newsletter/manana",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/newsletter/noche",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 6 * * *"
    }
  ]
}
